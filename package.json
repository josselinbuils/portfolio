{
  "name": "portfolio",
  "homepage": "https://josselinbuils.dev",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "analyse": "ANALYSE=true vite build",
    "build": "rimraf build && NODE_OPTIONS=\"--max-old-space-size=3072\" vite build && rimraf dist && cpx \"build/**/*\" dist && rimraf build",
    "dev": "ts-node-dev -r tsconfig-paths/register --project ./server/tsconfig.json ./server/devServer.ts",
    "lint": "yarn lint:code && yarn lint:typings",
    "lint:fix": "yarn lint:code -- --fix && yarn lint:typings",
    "lint:code": "eslint .",
    "lint:typings": "tsc",
    "pre-commit": "exec-staged",
    "prepare": "husky install",
    "start": "NODE_ENV=production ts-node -r tsconfig-paths/register --project ./server/tsconfig.json ./server/server.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-brands-svg-icons": "7.2.0",
    "@fortawesome/free-regular-svg-icons": "7.2.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0",
    "@fortawesome/react-fontawesome": "3.3.1",
    "@josselinbuils/utils": "0.4.2",
    "ansi_up": "6.0.6",
    "classnames": "2.5.1",
    "dayjs": "1.11.20",
    "dicom-parser": "1.8.21",
    "diff-match-patch": "1.0.5",
    "express": "5.2.1",
    "glob": "13.0.6",
    "jsonschema": "1.5.0",
    "preact": "10.29.1",
    "prettier": "3.8.3",
    "prismjs": "1.30.0",
    "sass": "1.66.1",
    "snoowrap": "1.23.0",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@josselinbuils/exec-staged": "1.0.2",
    "@preact/preset-vite": "2.5.0",
    "@types/diff-match-patch": "1.0.32",
    "@types/express": "5.0.6",
    "@types/prismjs": "1.26.6",
    "@types/source-map-support": "0.5.10",
    "@types/ws": "8.18.1",
    "@webgpu/types": "0.1.69",
    "cpx": "1.5.0",
    "csscomb": "4.3.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "8.0.3",
    "preact-render-to-string": "6.6.7",
    "prettier-plugin-glsl": "0.2.6",
    "rimraf": "6.1.3",
    "rollup-plugin-visualizer": "5.14.0",
    "ts-node-dev": "2.0.0",
    "typescript-eslint": "8.59.2",
    "vite": "4.4.9"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
